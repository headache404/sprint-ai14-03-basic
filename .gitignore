# =========================================================================
# Github에 올리지 말아야 할 파일 지정
# =========================================================================

# data 폴더와 그 하위의 모든 폴더/파일(png, json, txt 등)을 통째로 제외합니다.
data/**/*

# result 폴더의 CSV(결과물) 파일 제외 합니다.
result/*.csv

# project_data 이미지 업로드 제외 합니다
sprint_ai_project1_data/

# 파이썬 캐시
__pycache__/

# =========================================================================
# Exceptions (GitHub에 반드시 올려야 하는 예외 파일 지정)
# 예) !requirements.txt
# =========================================================================
!.gitkeep

# Local YOLO review outputs
/weights/
/runs/
/local-review/
**/.ipynb_checkpoints/
